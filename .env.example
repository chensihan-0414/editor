# Optional environment variables — the editor works without any of these

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3000)
# PORT=3000

# --- Vercel deployment: required for scene persistence to work ---
# Without these, scenes are saved to a local SQLite file, which does NOT
# persist on Vercel's stateless serverless functions — a scene created in
# Step 1 will likely 404 when Step 2 tries to load it.
# Get these from your Supabase project's Settings -> API page.
# Run supabase-schema.sql (packages/mcp/src/storage/) in the SQL Editor first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
